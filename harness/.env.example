# Bun loads .env automatically. Copy to .env and fill in what you have; neither is required
# if you replay a saved track with --track.

# OpenSky Network API client (opensky-network.org → Account → API client). Free.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Flightradar24 API token (fr24api.flightradar24.com). Paid plans; calls consume credits.
FR24_API_TOKEN=

# Analyzer command; receives `analyze <wav> --json [--threshold N]` and `scrub <in> <out>`.
# Default: ../.build/release/octave-camo if you've run `swift build -c release`, otherwise the
# NumPy reference. To force the reference:
# OCTAVE_CAMO_CMD="python3 ../reference/analyze_json.py"
OCTAVE_CAMO_CMD=
